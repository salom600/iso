def section(title):
    lbl = Gtk.Label(halign=Gtk.Align.START)
    lbl.set_markup(f"<b>{title}</b>")
    lbl.set_margin_bottom(6)
    return lbl


class Settings(Gtk.Application):
    def __init__(self, start_page=None):
        super().__init__(application_id="org.borealis.Settings")
        self.start_page = start_page or "appearance"
        self.win = None
        self.toggles = {}

    def do_activate(self):
        if self.win:
            self.win.present()
            return
        self.win = Gtk.ApplicationWindow(application=self, title="Borealis Settings",
                                         default_width=960, default_height=640)
        self.win.set_icon_name("borealis-settings")
        self.build_ui()
        self.win.show_all()
        self.show_page(self.start_page)

    # ---------- UI scaffold ----------
    def build_ui(self):
        outer = Gtk.Box(spacing=0)
        self.win.add(outer)

        self.sidebar = Gtk.ListBox()
        self.sidebar.set_size_request(220, -1)
        self.sidebar.set_margin_top(10); self.sidebar.set_margin_bottom(10)
        for pid, label in PAGES:
            row = Gtk.ListBoxRow()
            l = Gtk.Label(label=label, halign=Gtk.Align.START)
            l.set_margin_start(12); l.set_margin_top(7); l.set_margin_bottom(7)
            row.add(l); row.page = pid
            self.sidebar.add(row)
        self.sidebar.connect("row-selected", self._on_sidebar)
        outer.pack_start(self.sidebar, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        outer.pack_start(self.stack, True, True, 0)

        for pid, _ in PAGES:
            builder = getattr(self, f"page_{pid}")
            page = builder()
            sw = Gtk.ScrolledWindow()
            sw.set_margin_start(16); sw.set_margin_end(16)
            sw.set_margin_top(12); sw.set_margin_bottom(12)
            sw.add(page)
            self.stack.add_titled(sw, pid, pid.title())

    def _on_sidebar(self, _box, row):
        if row:
            self.stack.set_visible_child_name(row.page)

    def show_page(self, pid):
        for r in self.sidebar.get_children():
            if r.page == pid:
                self.sidebar.select_row(r)
                break

    def wrapped(self, *children, vertical=True):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL,
                      spacing=10)
        for c in children:
            box.pack_start(c, False, False, 0)
        return box

    # ---------- pages ----------
    def page_appearance(self):
        box = self.wrapped(section("Themes — click Apply to change everything at once"))
        self.theme_flow = Gtk.FlowBox()
        self.theme_flow.set_min_children_per_line(2)
        self.theme_flow.set_max_children_per_line(4)
        self.theme_flow.set_row_spacing(10); self.theme_flow.set_column_spacing(10)
        self.theme_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        box.pack_start(self.theme_flow, False, False, 4)
        box.pack_start(section("Wallpapers"), False, False, 4)
        self.wall_flow = Gtk.FlowBox()
        self.wall_flow.set_min_children_per_line(3)
        self.wall_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        box.pack_start(self.wall_flow, False, False, 4)
        GLib.idle_add(self.populate_appearance)
        return box

    def populate_appearance(self):
        current = bc.current_theme_name()
        for child in list(self.theme_flow.get_children()):
            self.theme_flow.remove(child)
        for child in list(self.wall_flow.get_children()):
            self.wall_flow.remove(child)
        for meta in bc.list_themes():
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            preview = Gtk.DrawingArea()
            preview.set_size_request(180, 92)
            accent = meta.get("accent", "#62d0ff")
            bg = meta.get("preview_bg", "#101526")
            preview.connect("draw", self._draw_preview, bg, accent)
            name_lbl = Gtk.Label()
            active = "  ●" if meta.get("name") == current else ""
            name_lbl.set_markup(
                f"<b>{GLib.markup_escape_text(meta.get('name', meta['slug']))}</b>"
                f"<small>{active}</small>")
            author = Gtk.Label()
            author.set_markup(f"<small>by {GLib.markup_escape_text(meta.get('author', 'Borealis'))}"
                              f" · {meta.get('variant', 'dark')}</small>")
            btn = Gtk.Button(label="Apply")
            btn.connect("clicked", self._on_apply_theme, meta["slug"])
            card.pack_start(preview, False, False, 0)
            card.pack_start(name_lbl, False, False, 0)
            card.pack_start(author, False, False, 0)
            card.pack_start(btn, False, False, 0)
            self.theme_flow.add(card)

        # wallpapers from themes + stock
        walls = ["/usr/share/backgrounds/borealis/aurora-night.png",
                 "/usr/share/backgrounds/borealis/glacier-light.png"]
        for meta in bc.list_themes():
            d = Path(meta["dir"])
            walls += [str(d / meta.get("wallpaper", "wallpaper.png"))]
        seen = set()
        for w in walls:
            if w in seen or not Path(w).is_file():
                continue
            seen.add(w)
            img = Gtk.Image.new_from_file(w)
            img.set_pixel_size(220)
            btn = Gtk.Button()
            btn.add(img)
            btn.set_tooltip_text(f"Set as wallpaper: {Path(w).name}")
            btn.connect("clicked", self._on_set_wallpaper, w)
            self.wall_flow.add(btn)
        self.theme_flow.show_all()
        self.wall_flow.show_all()
        return False

    @staticmethod
    def _draw_preview(area, cr, bg, accent):
        w, h = area.get_allocated_width(), area.get_allocated_height()
        cr.set_source_rgba(*Settings._parse_color(bg, (0.06, 0.08, 0.15)))
        cr.paint()
        cr.set_source_rgba(*Settings._parse_color(accent, (0.38, 0.82, 1.0)))
        cr.rectangle(0, h - 12, w * 0.62, 12)
        cr.fill()

    @staticmethod
    def _parse_color(hexstr, fallback):
        hx = hexstr.lstrip("#")
        if len(hx) == 6:
            try:
                return tuple(int(hx[i:i + 2], 16) / 255 for i in (0, 2, 4)) + (1.0,)
            except Exception:
                pass
        return fallback + (1.0,)

    def _on_apply_theme(self, _b, slug):
        def work():
            ok = bc.apply_theme(slug)
            GLib.idle_add(lambda: (bc.notify("Borealis Themes",
                                             "Theme applied" if ok else "Theme not found"),
                                   self.populate_appearance()) and False)
        threading.Thread(target=work, daemon=True).start()

    def _on_set_wallpaper(self, _b, path):
        cur = bc.CURRENT_DIR
        cur.mkdir(parents=True, exist_ok=True)
        import shutil
        shutil.copyfile(path, cur / "wallpaper")
        bc.run(["pkill", "-x", "swaybg"])
        os.system("setsid borealis-wallpaper >/dev/null 2>&1 &")
        bc.notify("Borealis", "Wallpaper updated")

