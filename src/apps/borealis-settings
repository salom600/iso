    def _refresh_system(self):
        def grab(cmd, pattern=None):
            r = bc.run(cmd)
            out = r.stdout.strip()
            if pattern:
                for line in out.splitlines():
                    if pattern in line:
                        return line.split(":", 1)[-1].strip() if ":" in line else line
            return out.splitlines()[0] if out else "n/a"

        rel = "Borealis Linux (see /etc/borealis-release)"
        try:
            rel = Path("/etc/borealis-release").read_text().strip()
        except Exception:
            pass
        kernel = grab(["uname", "-r"])
        cpu = grab(["lscpu"], "Model name")
        gpu = bc.run(["lspci"]).stdout
        gpu_line = next((l.split(":", 1)[-1].strip() for l in gpu.splitlines()
                         if "VGA" in l or "3D" in l), "n/a")
        with open("/proc/meminfo") as f:
            total = next(int(l.split()[1]) for l in f if l.startswith("MemTotal")) // 1024
        self.sys_lbl.set_markup(
            f"<b>{GLib.markup_escape_text(rel)}</b>\n"
            f"Kernel: {GLib.markup_escape_text(kernel)} · Debian 12 base")
        self.hw_lbl.set_markup(
            f"CPU: {GLib.markup_escape_text(cpu)}\n"
            f"GPU: {GLib.markup_escape_text(gpu_line)}\n"
            f"RAM: {total} MB")
        return False

