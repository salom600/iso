        ]
        box = self.wrapped(section("Keyboard shortcuts"))
        grid = Gtk.Grid(column_spacing=18, row_spacing=8)
        for i, (a, k) in enumerate(rows):
            grid.attach(Gtk.Label(label=a, halign=Gtk.Align.START), 0, i, 1, 1)
            kk = Gtk.Label(label=k, halign=Gtk.Align.START)
            kk.set_markup(f"<tt>{k}</tt>")
            grid.attach(kk, 1, i, 1, 1)
        box.pack_start(grid, False, False, 6)
        return box


def main():
    start_page = None
    for i, a in enumerate(sys.argv):
        if a == "--page" and i + 1 < len(sys.argv):
            start_page = sys.argv[i + 1]
    Settings(start_page).run(sys.argv)


if __name__ == "__main__":
    main()
