    def _on_store_load(self, *_):
        url = self.store_url_entry.get_text().strip()
        bc.STATE_DIR.mkdir(parents=True, exist_ok=True)
        bc.THEME_STORE_URL_FILE.write_text(url)
        for c in self.store_list.get_children():
            self.store_list.remove(c)
        self.store_list.add(Gtk.Label(label="Fetching index…"))
        self.store_list.show_all()

        def work():
            items, err = [], None
            try:
                import requests
                idx = requests.get(url, timeout=15).json()
                items = idx.get("themes", idx.get("items", []))
            except Exception as e:
                err = str(e)
            GLib.idle_add(lambda: self._fill_store(items, err) and False)
        threading.Thread(target=work, daemon=True).start()

    def _fill_store(self, items, err):
        for c in self.store_list.get_children():
            self.store_list.remove(c)
        if err:
            self.store_list.add(Gtk.Label(label=f"Could not reach the theme index:\n{err}"))
        elif not items:
            self.store_list.add(Gtk.Label(label="The index is empty — community themes can be submitted as pull requests to the themes repository."))
        for it in items:
            row = Gtk.Box(spacing=10)
            row.set_margin_start(8); row.set_margin_end(8)
            row.set_margin_top(6); row.set_margin_bottom(6)
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            n = Gtk.Label(halign=Gtk.Align.START)
            n.set_markup(f"<b>{GLib.markup_escape_text(it.get('name', '?'))}</b>"
                         f" <small>v{it.get('version', '?')} by {GLib.markup_escape_text(it.get('author', '?'))}</small>")
            d = Gtk.Label(halign=Gtk.Align.START)
            d.set_markup(f"<small>{GLib.markup_escape_text(it.get('description', ''))}</small>")
            txt.pack_start(n, False, False, 0)
            txt.pack_start(d, False, False, 0)
            row.pack_start(txt, True, True, 0)
            btn = Gtk.Button(label="Download & Apply")
            btn.connect("clicked", self._on_store_install, it)
            row.pack_start(btn, False, False, 0)
            self.store_list.add(row)
        self.store_list.show_all()
        return False

    def _on_store_install(self, _b, item):
        url = item.get("url")
        if not url:
            bc.notify("Borealis Theme Store", "Entry has no download URL", urgency="critical")
            return

        def work():
            try:
                import requests, tempfile
                with tempfile.NamedTemporaryFile(suffix=".tar.gz", delete=False) as tmp:
                    tmp.write(requests.get(url, timeout=120).content)
                    tarball = tmp.name
                dest = bc.USER_THEMES
                dest.mkdir(parents=True, exist_ok=True)
                with tarfile.open(tarball) as tf:
                    tf.extractall(dest)  # theme dirs ship a top-level <slug>/ folder
                os.unlink(tarball)
                slug = item.get("slug") or (url.rsplit("/", 1)[-1].split(".")[0])
                ok = bc.apply_theme(slug)
                msg = "Installed and applied" if ok else "Downloaded (Apply from Appearance)"
                GLib.idle_add(lambda: (bc.notify("Borealis Theme Store", msg),
                                       self.populate_appearance()) and False)
            except Exception as e:
                GLib.idle_add(lambda: bc.notify("Borealis Theme Store",
                                                f"Failed: {e}", urgency="critical") and False)
        threading.Thread(target=work, daemon=True).start()

    def _on_store_import(self, *_):
        dlg = Gtk.FileChooserNative(parent=self.win, title="Choose a .borealistheme tarball",
                                    action=Gtk.FileChooserAction.OPEN)
        filt = Gtk.FileFilter(); filt.set_name("Borealis themes")
        filt.add_pattern("*.borealistheme"); filt.add_pattern("*.tar.gz")
        dlg.add_filter(filt)
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            f = dlg.get_filename()
            dlg.destroy()
            try:
                bc.USER_THEMES.mkdir(parents=True, exist_ok=True)
                with tarfile.open(f) as tf:
                    tf.extractall(bc.USER_THEMES)
                bc.notify("Borealis Theme Store", "Theme imported — find it in Appearance")
                self.populate_appearance()
            except Exception as e:
                bc.notify("Borealis Theme Store", f"Import failed: {e}", urgency="critical")
        else:
            dlg.destroy()

    def page_performance(self):
        box = self.wrapped(section("Performance"))
        box.pack_start(self._toggle("Performance Mode",
                                    "Disables animations & transparency (best for 2008–2015 GPUs).",
                                    "perf", self._get_perf, self._set_perf), False, False, 0)
        box.pack_start(self._toggle("Game Boost",
                                    "CPU governor → performance, pauses background services, disables effects.",
                                    "boost", self._get_boost, self._set_boost), False, False, 0)
        self.perf_status = Gtk.Label()
        box.pack_start(self.perf_status, False, False, 6)
