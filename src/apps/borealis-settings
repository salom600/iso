        self.zram_lbl = Gtk.Label(label="zram: checking…")
        box.pack_start(self.zram_lbl, False, False, 0)
        GLib.idle_add(self._refresh_perf)
        return box

    def _toggle(self, title, subtitle, key, getter, setter):
        row = Gtk.Box(spacing=10)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        t = Gtk.Label(halign=Gtk.Align.START)
        t.set_markup(f"<b>{title}</b>")
        s = Gtk.Label(halign=Gtk.Align.START)
        s.set_markup(f"<small>{subtitle}</small>")
        txt.pack_start(t, False, False, 0); txt.pack_start(s, False, False, 0)
        sw = Gtk.Switch()
        sw.set_active(getter())
        sw.connect("state-set", lambda b, st: (setter(st), True)[1])
        self.toggles[key] = sw
        row.pack_start(txt, True, True, 0)
        row.pack_start(sw, False, False, 0)
        return row

    def _get_perf(self):
        return bc.perf_mode_enabled()

    def _set_perf(self, state):
        bc.run(["borealis-perf", "on" if state else "off"])

    def _get_boost(self):
        return bc.boost_enabled()

    def _set_boost(self, state):
        bc.run(["borealis-boost", "on" if state else "off"])

    def _refresh_perf(self):
        r = bc.run(["cat", "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"])
        gov = r.stdout.strip() or "n/a"
        r2 = bc.run(["zramctl"], timeout=10)
        zram = "active" if "zram" in (r2.stdout or "") else "not active"
        with open("/proc/meminfo") as f:
            mi = {l.split(":")[0]: int(l.split()[1]) for l in f if ":" in l}
        total = mi.get("MemTotal", 0) // 1024
        avail = mi.get("MemAvailable", 0) // 1024
        self.perf_status.set_markup(
            f"<small>CPU governor: <b>{gov}</b> · zram: <b>{zram}</b> · "
            f"RAM: <b>{total - avail}</b> MB used of {total} MB</small>")
        self.zram_lbl.set_markup(
            "<small>zram compresses memory instead of hitting the disk — "
            "it doubles usable RAM on old machines.</small>")
        for key, sw in self.toggles.items():
            getter = self._get_perf if key == "perf" else self._get_boost
            sw.set_active(getter())
        return False

