class AppEntry:
    def __init__(self, name, source, category, desc, *, pkg=None, flatpak=None,
                 snap=None, url=None, verb=None, prefix=None, homepage=None):
        self.name, self.source, self.category, self.desc = name, source, category, desc
        self.pkg, self.flatpak, self.snap = pkg, flatpak, snap
        self.url, self.verb, self.prefix, self.homepage = url, verb, prefix, homepage
        self.installed = False
        self.row = None


class Store(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.borealis.Store")
        self.apps = {}
        self.apt_cache = None
        self.category = "all"
        self.query = ""
        self.win = None

    # ---------- lifecycle ----------
    def do_activate(self):
        if self.win:
            self.win.present()
            return
        self.win = Gtk.ApplicationWindow(application=self, title="Borealis Store",
                                         default_width=1040, default_height=680)
        self.win.set_icon_name("borealis-store")
        self.build_ui()
        self.win.show_all()
        self.set_category("all")
        threading.Thread(target=self.load_state, daemon=True).start()

    # ---------- UI ----------
    def build_ui(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.win.add(outer)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        header.set_margin_top(10); header.set_margin_bottom(6)
        header.set_margin_start(12); header.set_margin_end(12)
        outer.pack_start(header, False, False, 0)

        title = Gtk.Label(); title.set_markup("<b>Borealis Store</b>")
        header.pack_start(title, False, False, 4)

        self.search = Gtk.SearchEntry(placeholder_text="Search all sources…")
        self.search.set_hexpand(True)
        self.search.connect("changed", self.on_search)
        header.pack_start(self.search, True, True, 6)

        self.spinner = Gtk.Spinner()
        header.pack_start(self.spinner, False, False, 4)

        body = Gtk.Box(spacing=10)
        body.set_margin_start(10); body.set_margin_end(10); body.set_margin_bottom(10)
        outer.pack_start(body, True, True, 0)

        # category sidebar
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_size_request(200, -1)
        self.sidebar = Gtk.ListBox()
