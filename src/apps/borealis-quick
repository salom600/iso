#!/usr/bin/env python3
# borealis-quick — compact quick-settings panel (Super+A): toggles, sliders,
# session actions. Reads live state on every open.

import os
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk

sys.path.insert(0, "/usr/lib/borealis")
import borealis_common as bc  # noqa: E402


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    except Exception:
        return None


def get_volume():
    r = run(["pactl", "get-sink-volume", "@DEFAULT_SINK@"])
    if r and r.returncode == 0:
        for part in r.stdout.split():
            if part.startswith("/"):
                return int(part[1:].rstrip("%")) / 100.0
    return None


def set_volume(frac):
    vol = max(0, min(150, int(frac * 100)))
    run(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{vol}%"])


def get_brightness():
    r = run(["brightnessctl", "g"])
    if r and r.returncode == 0 and r.stdout.strip().isdigit():
        m = run(["brightnessctl", "m"])
        if m and m.stdout.strip().isdigit() and int(m.stdout.strip()) > 0:
            return int(r.stdout.strip()) / int(m.stdout.strip())
    return None


def set_brightness(frac):
    run(["brightnessctl", "s", str(max(1, int(frac * 100))) + "%"])


class Quick(Gtk.Window):
    def __init__(self):
        super().__init__(title="Quick settings", skip_taskbar_hint=True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_default_size(360, -1)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("borealis")

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        outer.set_margin_top(12); outer.set_margin_bottom(12)
        outer.set_margin_start(12); outer.set_margin_end(12)
        self.add(outer)

        # --- toggles grid ---
        grid = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
        outer.pack_start(grid, False, False, 0)
        self.switches = {}
        defs = [
            ("Performance", "perf"),
            ("Game Boost", "boost"),
            ("Wi-Fi", "wifi"),
            ("Bluetooth", "bt"),
            ("Night Light", "night"),
            ("Do Not Disturb", "dnd"),
        ]
        for i, (label, key) in enumerate(defs):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            sw = Gtk.Switch(halign=Gtk.Align.CENTER)
            sw.connect("state-set", self.on_toggle, key)
            lbl = Gtk.Label(label=label)
            lbl.set_markup(f"<small>{label}</small>")
            box.pack_start(sw, False, False, 0)
            box.pack_start(lbl, False, False, 0)
            grid.attach(box, i % 3, i // 3, 1, 1)
            self.switches[key] = sw

        # --- sliders ---
        vol = get_volume()
        if vol is not None:
            outer.pack_start(self._slider("Volume", vol, set_volume, "audio-volume-high"), False, False, 0)
        br = get_brightness()
        if br is not None:
            outer.pack_start(self._slider("Brightness", br, set_brightness, "display-brightness"), False, False, 0)

        # --- action buttons ---
        row = Gtk.Box(spacing=6, homogeneous=True)
        for label, cmd in (
                ("Screenshot", ["borealis-screenshot", "--area"]),
                ("Lock", ["borealis-lock"]),
                ("Settings", ["borealis-settings"]),
                ("Log Out", ["loginctl", "terminate-session",
                             os.environ.get("XDG_SESSION_ID", "")]),
        ):
            b = Gtk.Button(label=label)
            b.connect("clicked", self.on_action, cmd)
            row.pack_start(b, True, True, 0)
        outer.pack_start(row, False, False, 2)
        self.refresh_states()

    def _slider(self, label, frac, setter, icon):
        box = Gtk.Box(spacing=8)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
        box.pack_start(img, False, False, 0)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.02)
        scale.set_value(frac)
        scale.set_draw_value(False)
        scale.connect("value-changed", lambda s: setter(s.get_value()))
        box.pack_start(scale, True, True, 0)
        return box

    # --- state ---
    def refresh_states(self):
        states = {
            "perf": bc.perf_mode_enabled(),
            "boost": bc.boost_enabled(),
            "wifi": self._radio("wifi"),
            "bt": self._radio("bluetooth"),
            "night": self._wlsunset_running(),
            "dnd": self._dnd(),
        }
        for key, val in states.items():
            self.switches[key].set_active(bool(val))

    def _radio(self, what):
        r = run(["nmcli", "radio", what])
        return bool(r and r.returncode == 0 and r.stdout.strip().startswith("enabled"))

    def _wlsunset_running(self):
        r = run(["pgrep", "-x", "wlsunset"])
        return bool(r and r.returncode == 0)

    def _dnd(self):
        r = run(["swaync-client", "-D"])
        return bool(r and "true" in (r.stdout or "").lower())

    def on_toggle(self, switch, state, key):
        if key == "perf":
            run(["borealis-perf", "on" if state else "off"])
        elif key == "boost":
            run(["borealis-boost", "on" if state else "off"])
        elif key == "wifi":
            run(["pkexec", "nmcli", "radio", "wifi", "on" if state else "off"])
        elif key == "bt":
            run(["bluetoothctl", "power", "on" if state else "off"])
        elif key == "night":
            if state:
                subprocess.Popen(["wlsunset", "-t", "3600"], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            else:
                run(["pkill", "-x", "wlsunset"])
        elif key == "dnd":
            run(["swaync-client", "-d"])

    def on_action(self, _b, cmd):
        if not cmd[-1] and cmd[-2] == "terminate-session":
            return  # no session id available — shouldn't happen under wayfire
        subprocess.Popen(cmd, start_new_session=True)
        GLib.timeout_add(150, Gtk.main_quit)


def main():
    win = Quick()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
