#!/usr/bin/env python3
# borealis-welcome — first-run wizard. Autostarted by Wayfire on every login
# but exits instantly unless ~/.config/borealis/.first-run-done is missing.

import subprocess
import sys
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

sys.path.insert(0, "/usr/lib/borealis")
import borealis_common as bc  # noqa: E402

MARKER = bc.STATE_DIR / ".first-run-done"


def card(icon, title, body, button_label=None, command=None):
    box = Gtk.Box(spacing=14)
    box.set_margin_top(10); box.set_margin_bottom(10)
    box.set_margin_start(12); box.set_margin_end(12)
    img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
    box.pack_start(img, False, False, 0)
    txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
    t = Gtk.Label(halign=Gtk.Align.START)
    t.set_markup(f"<b>{title}</b>")
    b = Gtk.Label(halign=Gtk.Align.START)
    b.set_line_wrap(True)
    b.set_markup(body)
    txt.pack_start(t, False, False, 0)
    txt.pack_start(b, False, False, 0)
    box.pack_start(txt, True, True, 0)
    if button_label and command:
        btn = Gtk.Button(label=button_label)
        btn.set_valign(Gtk.Align.CENTER)
        btn.connect("clicked", lambda *_: subprocess.Popen(command, start_new_session=True))
        box.pack_start(btn, False, False, 0)
    frame = Gtk.Frame()
    frame.get_style_context().add_class("view")
    frame.add(box)
    return frame


class Welcome(Gtk.Window):
    def __init__(self):
        super().__init__(title="Welcome to Borealis Linux")
        self.set_default_size(660, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("borealis")

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        outer.set_margin_top(14); outer.set_margin_bottom(14)
        outer.set_margin_start(16); outer.set_margin_end(16)
        self.add(outer)

        head = Gtk.Label()
        head.set_markup("<span size='x-large'><b>Welcome to Borealis Linux</b></span>\n"
                        "<small>Fast, quiet and yours — a familiar desktop for Windows & Mac switchers.</small>")
        outer.pack_start(head, False, False, 4)

        stack = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        outer.pack_start(stack, True, True, 0)

        stack.pack_start(card("borealis-settings",
                              "Make it yours",
                              "Pick a theme (try <b>Aurora Night</b> or the light <b>Glacier</b>), "
                              "set your wallpaper, tune performance for your hardware.",
                              "Open Settings", ["borealis-settings"]), False, False, 0)

        stack.pack_start(card("borealis-store",
                              "Get your apps",
                              "The Borealis Store installs from APT, Flatpak, Snap and AppImage — "
                              "one search box, one click. Browsers, office, Steam, Discord, VS Code.",
                              "Open Store", ["borealis-store"]), False, False, 0)

        stack.pack_start(card("borealis-wine",
                              "Windows programs & games",
                              "Double-click any <b>.exe</b> — Borealis prepares a Wine prefix with fonts "
                              "and runtimes for you. Games get DXVK (DirectX → Vulkan) automatically.",
                              "Store → Windows", ["borealis-store"]), False, False, 0)

        stack.pack_start(card("applications-games",
                              "Gamers",
                              "Toggle <b>Game Boost</b> from Quick Settings (Super+A): max CPU priority, "
                              "background services pause, effects off. Per-game: "
                              "<tt>borealis-gamerun -- %command%</tt>",
                              "Settings → Gaming", ["borealis-settings", "--page", "gaming"]), False, False, 0)

        stack.pack_start(card("video-display",
                              "Drivers & updates",
                              "AMD/Intel work out of the box. NVIDIA: one click here. "
                              "Updates are manual by design — no surprise background load.",
                              "Install drivers", ["borealis-driver-installer"]), False, False, 0)

        bottom = Gtk.Box(spacing=8)
        outer.pack_start(bottom, False, False, 0)

        install = Gtk.Button(label="Install Borealis Linux to this computer")
        install.get_style_context().add_class("suggested-action")
        install.connect("clicked", self.on_install)
        bottom.pack_start(install, True, True, 0)

        updates = Gtk.Button(label="Check for updates")
        updates.connect("clicked", self.on_updates)
        bottom.pack_start(updates, False, False, 0)

        close = Gtk.Button(label="Done")
        close.connect("clicked", lambda *_: self.close())
        bottom.pack_start(close, False, False, 0)

        self.connect("destroy", self.on_close)

    def on_install(self, *_):
        subprocess.Popen(["pkexec", "calamares"], start_new_session=True)

    def on_updates(self, *_):
        subprocess.Popen(["foot", "-e", "borealis-updater"], start_new_session=True)

    def on_close(self, *_):
        bc.STATE_DIR.mkdir(parents=True, exist_ok=True)
        MARKER.write_text("seen")


def main():
    if "--autostart" in sys.argv and MARKER.is_file():
        return
    win = Welcome()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
