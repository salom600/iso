#!/bin/sh
#
# 0250 — firmware bloat purge.
# Dependency chains (live-task-/meta-/qcom-media packages) drag datacenter and
# ARM firmware blobs into the amd64 desktop image; none of them serve the
# 2008–2026 PC/laptop target. Purging blobs cannot break other packages'
# dependencies. Kept: amd, intel, nvidia-gsp (nouveau Turing+), atheros,
# broadcom, realtek, mediatek-in-misc, libertas (2008 netbook wifi), sof audio.
set -e
export DEBIAN_FRONTEND=noninteractive

echo "HOOK 0250: purging irrelevant firmware blobs"
apt-get purge -y -qq \
    firmware-netronome \
    firmware-qcom-media firmware-qcom-soc \
    firmware-nvidia-tesla-gsp firmware-nvidia-tesla-535-gsp \
    raspi-firmware \
    nvidia-tesla-470-kernel-support \
    live-task-non-free-firmware-server \
    2>/dev/null || echo "HOOK 0250: partial purge (non-fatal)" >&2
apt-get autoremove -y -qq || true

exit 0
