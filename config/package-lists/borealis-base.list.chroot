##### Gaming #####
# (steam-installer installs in hook 0200 — it needs i386 multiarch enabled)
gamemode

##### Borealis Store + custom apps runtime #####
python3
python3-gi
gir1.2-gtk-3.0
python3-apt
python3-requests
flatpak
snapd

##### Wine/Windows layer deps (Wine itself installed by hook 0200 w/ i386) #####
cabextract
winbind

##### Installer: Calamares + target boot/encryption plumbing #####
calamares
grub2-common
# grub-pc (BIOS metapackage) conflicts with grub-efi-amd64; shipping both
# *-bin payload packages lets grub-install serve either firmware target.
grub-pc-bin
grub-efi-amd64
grub-efi-amd64-bin
efibootmgr
os-prober
cryptsetup
lvm2

##### Boot visuals / emergency fallback session #####
plymouth
openbox
xterm
